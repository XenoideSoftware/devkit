include(../base)

{% set cc = os.getenv("XENOIDE_CC", "gcc") %}
{% set cxx = os.getenv("XENOIDE_CXX", "g++") %}
{% set detected = detect_api.detect_gcc_compiler(cc) %}

[settings]
os=Windows
compiler=gcc
compiler.version={{ detected[1] }}
compiler.libcxx=libstdc++11
compiler.cppstd=17
compiler.cstd=17
compiler.threads=posix
compiler.exception=seh

[conf]
tools.build:compiler_executables={"c": "{{ cc }}", "cpp": "{{ cxx }}"}
tools.cmake.cmaketoolchain:generator=Ninja
user.xenoide:toolchain=mingw-gcc
user.xenoide:cc={{ cc }}
user.xenoide:cxx={{ cxx }}
